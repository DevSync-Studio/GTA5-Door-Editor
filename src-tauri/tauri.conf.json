{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTA5 Door Editor",
  "version": "1.0.0",
  "identifier": "GTA5-Door-Editor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GTA5 Door Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DevSync Studio",
    "copyright": "Copyright (c) 2026 DevSync Studio",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "shortDescription": "FiveM door editor",
    "longDescription": "Local editor for doortuning, YTYP door type, DAT151 audio, nametables, and YMT merge.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
